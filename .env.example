# --- AI provider (Volcengine Ark / ByteDance) ---
MODEL_PROVIDER=volcano
VOLCANO_API_URL=https://ark.cn-beijing.volces.com
VOLCANO_API_KEY=your_key_here
# Must be a valid image-generation model ID (doubao-seedream-*) or your Ark endpoint ID (ep-xxx)
VOLCANO_MODEL=doubao-seedream-4-0-250828
VOLCANO_SIZE=1024x1024

# --- MinIO ---
# Internal endpoint: used by api/worker containers inside the docker network
MINIO_ENDPOINT=minio:9000
# External endpoint: used to build presigned URLs that the browser opens
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_ACCESS=minioadmin
MINIO_SECRET=minioadmin
MINIO_BUCKET=generated

# --- Queue / Database ---
CELERY_BROKER_URL=redis://redis:6379/1
DATABASE_URL=sqlite:////app/data/data.db

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
